# Fix git 'WARNING: terminal is not fully functional'. Happens
# due to strawberry perl setting a global env. variable TERM=dump
#export TERM=msys

#export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64/bin
#export JDK_HOME=/usr/lib/jvm/java-1.17.0-openjdk-amd64

# Add user folders to the front of the PATH the session already has, instead of
# replacing it. Folders that don't exist are skipped; a folder already in PATH
# is moved to the front rather than added twice.
path_prepend() {
  [ -d "$1" ] || return 0
  local p=":$PATH:"
  p=${p//":$1:"/:}
  p=${p#:}; p=${p%:}
  PATH="$1${p:+:$p}"
}
path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"     # first: rofi-alfred, kitty and other user tools
export PATH

