# mcd DIR: create DIR (and parents) and cd into it.
function mcd() {
  if [ $# -ne 1 ]; then echo 'usage: mcd DIR' >&2; return 2; fi
  mkdir -p -- "$1" && cd -- "$1"
}

# cdf TEXT: cd into the one folder here whose name contains TEXT.
function cdf() {
  if [ $# -ne 1 ]; then echo 'usage: cdf TEXT' >&2; return 2; fi
  local d matches=()
  for d in *"$1"*/; do [ -d "$d" ] && matches+=("$d"); done
  case ${#matches[@]} in
    0) echo "cdf: no folder here contains '$1'" >&2; return 1 ;;
    1) cd -- "${matches[0]}" ;;
    *) echo "cdf: several folders contain '$1':" >&2
       printf '  %s\n' "${matches[@]}" >&2; return 1 ;;
  esac
}

